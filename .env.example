# App
APP_NAME=SuperMerch Lead Engine
APP_USERNAME=admin
APP_PASSWORD=change-me
SESSION_SECRET=change-this-to-a-long-random-string

# Database (Render injects DATABASE_URL in production)
DATABASE_URL=sqlite:///./supermerch_leads.db

# AI analysis / outreach
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Discovery: Google Places Text Search (New)
GOOGLE_PLACES_API_KEY=

# Optional settings
DEFAULT_COUNTRY=Nederland
CRAWL_TIMEOUT_SECONDS=12
MAX_CRAWL_PAGES=5
